  <style>
    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --border: #e2e8f0;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --accent-navy: #0f172a;
      --accent-gray: #f1f5f9;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--text-main);
      font-family: 'DM Sans', sans-serif;
      font-weight: 400;
      line-height: 1.5;
      padding: 3rem 1.5rem;
    }
    .container { max-width: 900px; margin: 0 auto; }

    /* ── HEADER INSTITUTIONNEL ── */
    header {
      text-align: center;
      padding-bottom: 2rem;
      border-bottom: 2px solid var(--accent-navy);
      margin-bottom: 2.5rem;
    }
    .institution {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      font-weight: 700;
    }
