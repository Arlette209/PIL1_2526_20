    .subtitle { color: var(--text-main); font-size: 0.95rem; font-weight: 500; }
    .meta-info { color: var(--text-muted); font-size: 0.85rem; margin-top: 0.25rem; }

    /* ── BLOC STATS SOBRE ── */
    .stats {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 1rem; margin: 1.5rem 0 0;
    }
    .stat {
      background: var(--accent-gray);
      border-radius: 6px; padding: 0.75rem; text-align: center;
    }
    .stat-val {
      font-size: 1.4rem; font-weight: 700; color: var(--accent-navy);
    }
    .stat-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; }

    /* ── SECTION TITLE ── */
    .section-title {
      font-size: 1.1rem; font-weight: 700; color: var(--accent-navy);
      margin: 2.5rem 0 1rem; padding-bottom: 0.3rem;
      border-bottom: 1px solid var(--border);
    }

    /* ── CALENDRIER TABLEAU ── */
    .cal-table {
      width: 100%; border-collapse: collapse; background: var(--surface);
      border: 1px solid var(--border); border-radius: 6px; overflow: hidden;
    }
    .cal-table th, .cal-table td {
      padding: 0.75rem 1rem; text-align: left; font-size: 0.85rem;
    }
    .cal-table th { background: var(--accent-gray); font-weight: 700; color: var(--accent-navy); }
    .cal-table td { border-bottom: 1px solid var(--border); }
    .cal-table tr:last-child td { border-bottom: none; }
    .deadline-row { background: #fff7ed; }

    /* ── CARTES DE MEMBRES ÉPURAÉES ── */
    .cards { display: flex; flex-direction: column; gap: 1.5rem; }
    .card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 8px; padding: 1.5rem;
    }
    .card-head {
      display: flex; justify-content: space-between; align-items: flex-start;
      margin-bottom: 1.2rem; padding-bottom: 0.75rem; border-bottom: 1px dashed var(--border);
    }
    .card-title { font-weight: 700; font-size: 1.1rem; color: var(--accent-navy); }
    .card-role { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.1rem; }
    .module-badge {
      background: var(--accent-gray); border: 1px solid var(--border);
      border-radius: 4px; padding: 0.2rem 0.6rem; font-size: 0.75rem; color: var(--text-main);
    }

    .card-body { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .col-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; }
    
    .task-list, .livrable-list { list-style-position: inside; }
    .task-list li, .livrable-list li { font-size: 0.85rem; margin-bottom: 0.4rem; color: var(--text-main); }
    .livrable-list li { color: #334155; }

    .tech-row {
      display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem;
    }
    .tech {
      background: #f8fafc; border: 1px solid var(--border);
      border-radius: 4px; padding: 0.15rem 0.5rem; font-size: 0.75rem; color: var(--text-muted);
    }

    /* ── MATRICE ── */
    .matrix {
      background: var(--surface); border: 1px solid var(--border); border-radius: 6px; overflow: hidden;
    }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    th { padding: 0.75rem 1rem; background: var(--accent-gray); text-align: left; color: var(--accent-navy); }
    td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); }
    tbody tr:last-child td { border-bottom: none; }
    
    .prio { font-weight: 600; font-size: 0.8rem; }
    .prio.high { color: #b91c1c; }
    .prio.med { color: #c2410c; }
    .prio.low { color: #15803d; }

    /* ── NOTES ── */
    .note-box {
      background: var(--surface); border-left: 4px solid var(--accent-navy);
      padding: 1rem; margin-top: 1rem; border-top: 1px solid var(--border);
      border-right: 1px solid var(--border); border-bottom: 1px solid var(--border);
      border-radius: 0 4px 4px 0; font-size: 0.85rem;
    }

    footer {
      text-align: center; margin-top: 4rem; padding-top: 1.5rem;
      border-top: 1px solid var(--border); color: var(--text-muted); font-size: 0.8rem;
    }
  </style>
</head>
